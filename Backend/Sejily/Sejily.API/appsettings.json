{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=SejilyDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Jwt": {
    "Key": "my-super-secret-key-for-sejily-2026",
    "Issuer": "SejilyAPI",
    "Audience": "SejilyClients"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  
  "Icd": {
    "Version": 10
  },

  "Notifications": {
    "DefaultLimit": 20,
    "MaxLimit": 50,
    "MaxTokenLength": 512
  },

  "AccessTiming": {
    "UndoWindowSeconds": 90,
    "RequestValidityHours": 48,
    "EmergencyResponseHours": 48
  },

  "Escalation": {
    "PollSeconds": 10,
    "BatchSize": 100
  },

  "RateLimiting": {
    "GeneralPerMinute": 120,
    "WritePerMinute": 30,
    "EmergencyRespondPerMinute": 6
  },

  "AllowedHosts": "*"
}
